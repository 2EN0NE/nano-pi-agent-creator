#!/bin/sh
# ──────────────────────────────────────────────────────────────────────────────
# pre-push hook: 推送前类型检查 + 单元测试 + 变更模块的 e2e 测试
# ──────────────────────────────────────────────────────────────────────────────
# 策略：与 CI 对齐但降权耗时步骤。
#   ✅ typecheck  — 有 .ts 变更时运行（CI 阻塞，此处也阻塞）
#   ✅ test       — Vitest 单元测试（CI 阻塞，此处也阻塞）
#   ✅ e2e 测试   — 仅变更模块（CI 阻塞，此处 blocking exit 1）
#   ❌ format:check — pre-commit 已跑，不重复
#   ❌ semgrep     — 太慢，仅 CI 跑
#
# 通过 git diff --name-only 检测本次推送变更的模块，仅运行受影响模块的测试。
# 如果变更覆盖多个模块，最坏情况跑全量测试（耗时可能较长）。

# 切换到 git 根目录，确保相对路径在任何工作目录下都正确
cd "$(git rev-parse --show-toplevel)" || exit 0

# 只在有变更文件时运行（跳过空推送、标签推送等）
# 使用 @{push}..HEAD 对比远程跟踪分支，支持多次提交后推送的场景
# 首次推送或无远程跟踪分支时静默跳过
CHANGED_FILES=$(git diff --name-only "@{push}..HEAD" 2>/dev/null || echo "")

if [ -z "$CHANGED_FILES" ]; then
  exit 0
fi

# ── 类型检查 + 合规门禁（当有 .ts/.tsx 变更时）──
if echo "$CHANGED_FILES" | grep -q '\.tsx\?$'; then
	echo "🔍 pre-push: typecheck..."
  npm run typecheck
  if [ $? -ne 0 ]; then
    echo "❌ TypeScript errors found. Fix before pushing."
    exit 1
  fi

	echo "🔍 pre-push: TUI 合规门禁..."
  npm run lint:tui
  if [ $? -ne 0 ]; then
    echo "❌ TUI 合规违规（双宽 emoji / 硬编码颜色 / 方角边框等）。Fix before pushing."
    exit 1
  fi

	echo "🔍 pre-push: config 锚点门禁（阻塞，对齐 CI config-compliance job）..."
  npm run lint:config:anchor
  if [ $? -ne 0 ]; then
    echo "❌ 仓库级配置消费者未声明解析锚点。见 AGENTS.md「项目级配置的解析锚点」。"
    exit 1
  fi

	echo "🔍 pre-push: config 合规门禁（WARN，不阻塞）..."
  npm run lint:config
  echo "⚠️  config 合规违规已列出（当前为 WARN，不阻塞推送）。请尽快将基础组件与独立插件解耦。"
fi

# ── 单元测试（对齐 CI unit-tests job）──
echo "🔍 pre-push: vitest..."
npm test
if [ $? -ne 0 ]; then
  echo "❌ Unit tests failed. Fix before pushing."
  exit 1
fi

# 提取变更的扩展名和技能名
EXTS=""
SKILLS=""
BENCH_CHANGED=""
# e2e 运行器 / TUI 助手变更 → 影响**所有**模块，用「代表 shard」做金丝雀（见文件末尾）
RUNNER_CHANGED=""
for file in $CHANGED_FILES; do
  name=""
  case "$file" in
    # e2e 基础设施（run-e2e.sh、tui-functions.sh 等）→ 影响所有模块，触发金丝雀分片
    test/e2e/scripts/*|test/e2e/helpers/*)
      RUNNER_CHANGED=1
      ;;
    # bench/ 工具链变更 → 触发 bench python 单测 + bench-run 技能 e2e（见测试分析发现 P1）
    bench/*)
      BENCH_CHANGED=1
      ;;
    # 顶层技能：skills/<category>/<name>/SKILL.md 或 skills/<name>/SKILL.md
    skills/*/*/SKILL.md|skills/*/SKILL.md)
      name=$(basename "$(dirname "$file")")
      SKILLS="$SKILLS $name"
      ;;
    # 扩展资产：extensions/<category>/<name>/** —— 入口 index.ts、单文件 name.ts、
    # 内部 lib/**、内嵌 skills/**（ADR-0022：内嵌技能随扩展分发，故归其扩展名下）
    # ⚠ 历史缺陷：过去只匹配 extensions/*/index.ts 与 extensions/*/*.ts，导致
    # extensions/<cat>/<name>/lib/*.ts 这类嵌套改动被整段跳过——改了实现却不在
    # 推送前跑该模块 e2e。统一按「extensions/ 之后的第 2 段」取模块名。
    extensions/*)
      rel="${file#extensions/}"
      rest="${rel#*/}" # 去掉 category 段
      case "$rest" in
        */*) name="${rest%%/*}" ;;  # 目录扩展（入口 / 内部文件 / 内嵌技能）
        *.ts) name="${rest%.ts}" ;; # 单文件扩展 extensions/<cat>/<name>.ts
        *) ;;                       # 其他（无扩展名归属）→ 不触发
      esac
      if [ -n "$name" ]; then EXTS="$EXTS $name"; fi
      ;;
    # e2e 测试自身变更 → 触发被测模块（改断言 / 加用例都必须真的跑一遍）
    test/e2e/extensions/*)
      rel="${file#test/e2e/extensions/}"
      name="${rel%%/*}"
      if [ -n "$name" ]; then EXTS="$EXTS $name"; fi
      ;;
    test/e2e/skills/*)
      rel="${file#test/e2e/skills/}"
      name="${rel%%/*}"
      if [ -n "$name" ]; then SKILLS="$SKILLS $name"; fi
      ;;
  esac
done

# scripts/ 变更（sync 工具、桥接等基础设施脚本）→ 触发 sync-tool e2e
if echo "$CHANGED_FILES" | grep -q '^scripts/'; then
  EXTS="$EXTS sync-tool"
fi

# bench/ 变更 → 先跑 bench python 单测（对齐 CI bench-unit job），
# 并把 bench-run 加入 SKILLS 以复用下方的 e2e 循环（测试目录 test/e2e/skills/bench-run/）。
if [ -n "$BENCH_CHANGED" ]; then
  echo "🔍 pre-push: bench 单元测试..."
  if command -v python3 >/dev/null 2>&1; then
    for t in bench/test_*.py; do
      python3 "$t" || { echo "❌ bench 单测失败：$t"; exit 1; }
    done
  else
    echo "⚠️  python3 缺失，跳过 bench 单测"
  fi
  SKILLS="$SKILLS bench-run"
fi

# 去重
EXTS=$(echo "$EXTS" | tr ' ' '\n' | sort -u | tr '\n' ' ')
SKILLS=$(echo "$SKILLS" | tr ' ' '\n' | sort -u | tr '\n' ' ')

if [ -z "$EXTS" ] && [ -z "$SKILLS" ] && [ -z "$RUNNER_CHANGED" ]; then
  # 没有变更涉及的扩展/技能，跳过
  exit 0
fi

echo "🔍 pre-push: e2e tests for changed modules..."
echo "   Extensions:${EXTS:- (none)}"
echo "   Skills:${SKILLS:- (none)}"

# 逐模块运行测试（阻塞推送：任一模块失败或 review-required 则 exit 1）
ALL_PASS=true

for ext in $EXTS; do
  echo "   → Testing extension: $ext"
  CI=true bash test/e2e/scripts/run-e2e.sh --ext "$ext" >/dev/null 2>&1
  if [ $? -eq 0 ] || [ $? -eq 124 ]; then
    echo "      ✅ $ext passed"
  else
    echo "      ⚠️  $ext has review-required or failed cases"
    ALL_PASS=false
  fi
done

for skill in $SKILLS; do
  echo "   → Testing skill: $skill"
  CI=true bash test/e2e/scripts/run-e2e.sh --skill "$skill" >/dev/null 2>&1
  if [ $? -eq 0 ] || [ $? -eq 124 ]; then
    echo "      ✅ $skill passed"
  else
    echo "      ⚠️  $skill has review-required or failed cases"
    ALL_PASS=false
  fi
done

# e2e 运行器 / TUI 助手变更：影响所有模块，但逐个跑全量太慢。
# 用「固定代表分片」做金丝雀：能抓住脚本语法错、参数解析错、_shard_match 误选、
# 沙箱/expect 助手失效这类全局性回归；剩余模块由 CI 分片矩阵覆盖。
if [ -n "$RUNNER_CHANGED" ]; then
  echo "   → e2e 基础设施变更：金丝雀分片（shard 0/8）"
  CI=true bash test/e2e/scripts/run-e2e.sh --shard 0/8 >/dev/null 2>&1
  if [ $? -eq 0 ] || [ $? -eq 124 ]; then
    echo "      ✅ canary shard passed"
  else
    echo "      ⚠️  canary shard failed（run-e2e.sh / tui-functions.sh 可能已坏）"
    ALL_PASS=false
  fi
fi

if [ "$ALL_PASS" = false ]; then
  echo "⚠️  Some e2e tests flagged review-required or had failures."
  echo "   Check test/results/$(ls -1t test/results/ | head -1)/ for details."
  exit 1
fi

exit 0
