#!/bin/sh
# ──────────────────────────────────────────────────────────────────────────────
# pre-commit hook: 提交前快速校验（对齐 CI，但跳过耗时步骤）
# ──────────────────────────────────────────────────────────────────────────────

cd "$(git rev-parse --show-toplevel)" || exit 1

# git commit 触发 hook 时会设置 GIT_DIR / GIT_INDEX_FILE（指向 worktree 的
# gitdir/index），这些环境变量会泄漏到 lint-staged 与 npm test 的子进程，
# 让测试里的 git 操作作用到本仓库（而非 sandbox），污染 index（表现为大量
# 文件被误删/误增）。在最前面清除，确保后续 git 命令都使用默认仓库。
unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_PREFIX

# ── 1. 增量 auto-fix ──
npm run lint:staged

# ── 2. 格式校验 ──
echo "🔍 pre-commit: format:check..."
npm run format:check
if [ $? -ne 0 ]; then
  echo "❌ Formatting issues found. Run 'npm run format' to fix."
  exit 1
fi

# ── 3. 单元测试 ──
echo "🔍 pre-commit: vitest..."
# worktree* 测试执行真实 git 操作（worktree/merge/rebase），与 git commit 环境
# 冲突（不稳定失败）；这些测试仍由 CI 与 pre-push 覆盖。
npm test -- --exclude '**/worktree*.test.ts'
if [ $? -ne 0 ]; then
  echo "❌ Unit tests failed. Fix before committing."
  exit 1
fi

# ── 4. TODO 提醒（warning，不阻断）──
# 本地开发记录 .pi/todos/TODO.md（gitignore 内，不随代码分发）。
# 文件不存在（如其他机器 clone 后未生成）则静默跳过，不打扰。
if [ -f .pi/todos/TODO.md ]; then
  echo "📋 pre-commit: TODO 提醒..."
  TODO_OPEN=$(grep -cE '^### \[ \]' .pi/todos/TODO.md 2>/dev/null)
  TODO_OPEN=${TODO_OPEN:-0}
  if [ "$TODO_OPEN" -gt 0 ] 2>/dev/null; then
    echo "⚠️  .pi/todos/TODO.md 有 ${TODO_OPEN} 条未完成 TODO："
    grep -E '^### \[ \]' .pi/todos/TODO.md | sed 's/^### \[ \] //' | head -5 | sed 's/^/    · /'
    if [ "$TODO_OPEN" -gt 5 ] 2>/dev/null; then
      echo "    · ... 及另外 $((TODO_OPEN - 5)) 条（完整清单见 .pi/todos/TODO.md）"
    fi
  else
    echo "✅ .pi/todos/TODO.md 无未完成 TODO"
  fi
fi

exit 0
