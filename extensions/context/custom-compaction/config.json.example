{
  "enabledProfileIds": ["default"],
  "triggerGranularity": "agent_turn",
  "routingRules": [
    { "model": "openai/", "targetProfileId": "default" }
  ],
  "profiles": {
    "default": {
      "id": "default",
      "name": "Default",
      "model": "current",
      "trigger": { "type": "context_percent", "threshold": 20 },
      "mechanism": { "type": "summarize" },
      "prompt": "",
      "autoContinue": true,
      "injectContinueText": false,
      "autoContinueMessage": "刚才因上下文压缩打断了工作，如果之前还有没有做完的内容请继续，如果都已经做完了总结下你的成果。注意我这里不是回答你最后的问题或请求，只是打断后的补充。"
    },
    "smart-compact": {
      "id": "smart-compact",
      "name": "EESV Smart Compact",
      "model": "current",
      "trigger": { "type": "context_percent", "threshold": 70 },
      "mechanism": { "type": "adapter", "adapterId": "smart_compact" },
      "prompt": "",
      "autoContinue": false
    }
  }
}
